# ========================================
# SERVER CONFIGURATION
# ========================================
NODE_ENV=development
PORT=3001
HOST=localhost
BASE_URL=http://localhost:3001

# ========================================
# DATABASE CONFIGURATION
# ========================================
# MongoDB Configuration (for production)
MONGODB_URI=mongodb://localhost:27017/voting-system

# Use In-Memory Database (NO MongoDB required!)
# Set to 'true' to use in-memory storage (perfect for development/testing)
# Server will automatically fallback to in-memory if MongoDB is unavailable
USE_MEMORY_DB=false

# ========================================
# JWT & SECURITY SECRETS
# ========================================
# ⚠️  CHANGE ALL SECRETS IN PRODUCTION!
JWT_SECRET=your-very-secure-jwt-secret-key-change-in-production
VOTING_SECRET=your-very-secure-voting-secret-key-change-in-production
SESSION_SECRET=your-session-secret-key-change-in-production

# ========================================
# TOKEN EXPIRY
# ========================================
TOKEN_EXPIRY=24h
VOTING_TOKEN_EXPIRY=10m

# ========================================
# CORS CONFIGURATION
# ========================================
CORS_ORIGIN=*

# ========================================
# ADMIN CREDENTIALS (for initial setup)
# ========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ========================================
# FEATURE FLAGS
# ========================================
ENABLE_REAL_TIME_NOTIFICATIONS=true
ENABLE_SOCKET_IO=true
LOG_LEVEL=info
